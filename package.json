{
  "name": "pipoca",
  "version": "1.0.0",
  "description": "AI-powered subtitle translation using local llama.cpp models",
  "type": "module",
  "scripts": {
    "build": "node scripts/esbuild.js src/app.ts builddir/app.js",
    "dev": "node scripts/esbuild.js src/app.ts builddir/app.js --watch",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.js\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.js\" \"*.config.js\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "update-sources": "scripts/update-sources.sh"
  },
  "keywords": [
    "subtitle",
    "translation",
    "ai",
    "llama.cpp",
    "srt",
    "language",
    "local",
    "privacy",
    "gnome",
    "gtk"
  ],
  "author": "Thiago Duarte <tduarte@github.com>",
  "license": "BlueOak-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tduarte/Pipoca.git"
  },
  "bugs": {
    "url": "https://github.com/tduarte/Pipoca/issues"
  },
  "homepage": "https://github.com/tduarte/Pipoca",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/adw-1": "1.8.0-4.0.0-beta.36",
    "@girs/gdk-4.0": "4.0.0-4.0.0-beta.36",
    "@girs/gio-2.0": "2.84.4-4.0.0-beta.36",
    "@girs/gjs": "4.0.0-beta.36",
    "@girs/glib-2.0": "2.84.4-4.0.0-beta.36",
    "@girs/gobject-2.0": "2.84.4-4.0.0-beta.36",
    "@girs/gtk-4.0": "4.19.1-4.0.0-beta.36",
    "@girs/soup-3.0": "3.6.5-4.0.0-beta.36",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "esbuild": "^0.28.2"
  }
}
